# Copia este archivo como .env.local y ajusta los valores.

# Tamaño máximo (MB) de los archivos que se SUBEN al servidor (/api/upload).
# Solo afecta a los .doc y a la subida opcional: PDF, DOCX y HTML se procesan
# en el navegador sin este límite. En Vercel el máximo real por petición es ~4.5 MB:
# allí conviene MAX_UPLOAD_MB=4 para mostrar un mensaje claro.
MAX_UPLOAD_MB=20

# Rate limit por IP para /api/upload: peticiones permitidas por ventana.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
